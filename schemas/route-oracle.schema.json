{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/wayglassarc/schemas/route-oracle.schema.json",
  "title": "Small-graph hand-calculated route oracle",
  "type": "object",
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "OK",
        "NO_ROUTE"
      ]
    },
    "cost_ms_decimal": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "segment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "network_id",
    "profile_id",
    "source",
    "target",
    "status",
    "cost_ms_decimal",
    "segment_ids"
  ],
  "additionalProperties": false
}
