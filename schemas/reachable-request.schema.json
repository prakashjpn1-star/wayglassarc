{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/wayglassarc/schemas/reachable-request.schema.json",
  "title": "Inclusive travel-budget reachable set",
  "type": "object",
  "properties": {
    "network_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "budget_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "network_id",
    "profile_id",
    "profile_version",
    "source",
    "budget_ms"
  ],
  "additionalProperties": false
}
